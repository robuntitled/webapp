# Copia questo file in .env.local e compila i valori reali.
# NON committare mai .env.local su GitHub.

# ── App ──────────────────────────────────────────────────────────────────────
AUTH_SECRET=
NEXT_PUBLIC_APP_NAME=NomadLink
# NEXT_PUBLIC_APP_URL=https://tuodominio.it

# ── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Connection string PostgreSQL (Supabase → Settings → Database → URI)
# Necessaria per migration DB: npm run db:security / npm run db:gdpr
SUPABASE_DB_URL=

# ── Altri servizi ────────────────────────────────────────────────────────────
PEXELS_API_KEY=

# ── Profilo legale (GDPR) — compila prima del lancio in produzione ───────────
# Obbligatori per documenti validi (privacy, termini, footer):
# LEGAL_COMPANY_NAME=
# LEGAL_VAT_ID=
# LEGAL_ADDRESS_LINE=
# LEGAL_CITY=
# LEGAL_POSTAL_CODE=
# LEGAL_EMAIL_PRIVACY=

# Consigliati:
# LEGAL_TRADE_NAME=NomadLink
# LEGAL_FISCAL_CODE=
# LEGAL_PROVINCE=
# LEGAL_COUNTRY=Italia
# LEGAL_EMAIL_SUPPORT=supporto@tuodominio.it
# LEGAL_EMAIL_DPO=
# LEGAL_PEC=
# LEGAL_PHONE=
# LEGAL_REA=
# LEGAL_SHARE_CAPITAL=
# LEGAL_WEBSITE_URL=https://tuodominio.it

# Esempio compilato (sostituisci con i tuoi dati reali):
# LEGAL_COMPANY_NAME=NomadLink S.r.l.
# LEGAL_TRADE_NAME=NomadLink
# LEGAL_VAT_ID=IT12345678901
# LEGAL_FISCAL_CODE=12345678901
# LEGAL_ADDRESS_LINE=Via Esempio 1
# LEGAL_CITY=Milano
# LEGAL_PROVINCE=MI
# LEGAL_POSTAL_CODE=20100
# LEGAL_COUNTRY=Italia
# LEGAL_EMAIL_PRIVACY=privacy@tuodominio.it
# LEGAL_EMAIL_SUPPORT=supporto@tuodominio.it
# LEGAL_PEC=azienda@pec.it
# LEGAL_REA=MI-1234567
# LEGAL_SHARE_CAPITAL=€ 10.000 i.v.
# LEGAL_WEBSITE_URL=https://tuodominio.it