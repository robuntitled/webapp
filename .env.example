# Copia questo file in .env.local e compila i valori reali.
# NON committare mai .env.local su GitHub.

# ── App ──────────────────────────────────────────────────────────────────────
AUTH_SECRET=
# Obbligatorio su Vercel per OAuth (usa il dominio produzione, senza slash finale):
# AUTH_URL=https://webapp-bice-six-42.vercel.app
# AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_NAME=NomadLink
NEXT_PUBLIC_APP_URL=https://webapp-bice-six-42.vercel.app

# ── OAuth (Auth.js accetta anche AUTH_GOOGLE_ID / AUTH_FACEBOOK_ID) ───────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
#
# Google Cloud → Credentials → OAuth client → Authorized redirect URIs:
#   https://TUO-DOMINIO/api/auth/callback/google
# Meta Developer → App → Facebook Login → Valid OAuth Redirect URIs:
#   https://TUO-DOMINIO/api/auth/callback/facebook
# Meta Developer → Settings → Basic → App Domains: TUO-DOMINIO (senza https)
# Meta Developer → Settings → Basic → Site URL: https://TUO-DOMINIO

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Connection string PostgreSQL (Supabase → Settings → Database → URI)
# Necessaria per migration DB: npm run db:security / npm run db:gdpr
SUPABASE_DB_URL=

# ── Cloudflare Turnstile (captcha free su Registrati) ────────────────────────
# https://dash.cloudflare.com → Turnstile → Add widget
# Hostname: tuo dominio Vercel + localhost (per test)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Senza secret: captcha disattivato (dev ok). Con secret: token obbligatorio.

# ── Email verifica account (Resend) ──────────────────────────────────────────
# https://resend.com → API key. Senza key: in dev il link va nei log server.
# RESEND_API_KEY=
# EMAIL_FROM=NomadLink <noreply@tuodominio.it>
# (dominio verificato su Resend; in sandbox usa onboarding@resend.dev)

# ── Rate limit + cache distribuita ( fortmente consigliato in produzione ) ───
# https://console.upstash.com → Redis → REST URL + token
# Usato per: rate-limit, AI cache/budget/quota, cache Google Places cross-istanza
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# In produzione logga errore se manca Redis (imposta false per silenziare):
# REQUIRE_UPSTASH=true
# Metriche API strutturate (cache hit/miss) nei log Vercel:
# API_METRICS=true
# TTL cache Places DB in giorni (0 = mai scadere). Default 14 + stale-while-revalidate:
# PLACES_CACHE_TTL_DAYS=14
#
# Dashboard costi (/dashboard/costi) — email admin separate da virgola:
# ADMIN_EMAILS=tuo@email.com

# ── Verifica telefono (priorità: WhatsApp → Twilio SMS → dev log) ────────────
# Obbligo create/join/publish solo se true (default: spento, ok in sviluppo)
# PHONE_VERIFY_REQUIRED=true
#
# WhatsApp Cloud API (Meta) — consigliato
# 1. Meta Business → WhatsApp → API Setup
# 2. Crea template categoria AUTHENTICATION (OTP), lingua IT, nome es. nomadlink_otp
# 3. Variabile body {{1}} = codice (e button URL se previsto dal template)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TEMPLATE=nomadlink_otp
# WHATSAPP_OTP_TEMPLATE_LANG=it
# WHATSAPP_OTP_BUTTON_COPY=true   # false se il template non ha bottone URL
#
# Fallback SMS (Twilio Verify) se WhatsApp non configurato
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
#
# Senza nessuna env: modalità dev (codice nei log server)

# ── AI Composer (Ollama / Groq / OpenAI-compatible / Gemini) ─────────────────
# AI_COMPOSER_ENABLED=true
# AI_PROVIDER=openai
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2:3b
# AI_API_KEY=              # opzionale per Ollama locale; obbligatorio per Groq/OpenAI cloud
# AI_JSON_MODE=false       # true solo se il modello supporta response_format json_object
# AI_SINGLE_MESSAGE=true   # unisce system+user (consigliato per modelli piccoli)
# AI_MAX_OUTPUT_TOKENS=800
# mock = solo smart locale | auto = AI se disponibile | openai | gemini
# AI_COMPOSER_MODE=auto
# AI_TIMEOUT_MS=45000
# Kill-switch costi (consigliato in produzione): 10-50 USD/mese
# AI_MONTHLY_BUDGET_USD=20
# AI_CACHE_TTL_MS=86400000
#
# Alternativa Gemini (cloud) — API key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash-lite
# Qualità superiore con billing Google attivo:
# AI_MODEL=gemini-3.5-flash
#
# Nota free tier: ~10 richieste/min. Evita click ripetuti su "Suggerisci giornata";
# la cache riduce le chiamate.

# ── Google Maps (mappa + ricerca attività nel composer) ───────────────────────
# 1. https://console.cloud.google.com/ → APIs & Services → Library
# 2. Abilita:
#    - Maps JavaScript API (mappa composer)
#    - Places API (New)  ← ricerca attività (Nearby + Text Search) — consigliato
#    - Places API (legacy) opzionale, usato come fallback
# 3. Credentials → API key
#    - Per la mappa browser: restrizione HTTP referrers (localhost + dominio Vercel)
#    - Per Places server-side: meglio una key separata con restrizione IP o senza
#      referrer (oppure stessa key se le API sono abilitate senza restrizioni bloccanti)
# 4. Opzionale server-only (preferita per Places da API route):
# GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Legacy Mapbox (non più usato dal composer — puoi rimuoverlo)
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# ── Altri servizi ────────────────────────────────────────────────────────────
PEXELS_API_KEY=

# ── Travel API — hotel + voli (search / prebook / book) ───────────────────────
# Dashboard: https://dashboard.liteapi.travel/ → Sandbox API key
LITEAPI_KEY=
# Markup % di default sul prezzo (tua commissione), es. 10
LITEAPI_MARGIN=10
# Opzionale override base URL
# LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0

# Origine voli default (IATA)
NEXT_PUBLIC_DEFAULT_ORIGIN_IATA=ROM

# Opzionale: chiave Stripe publishable di LiteAPI (Elements diretto).
# Se assente, il checkout usa il Payment SDK ufficiale (publicKey sandbox/live).
# LITEAPI_STRIPE_PUBLISHABLE_KEY=pk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Forza ambiente payment SDK: sandbox | live
# LITEAPI_PAYMENT_ENV=sandbox

# ── Profilo legale (GDPR) — compila prima del lancio in produzione ───────────
# Obbligatori per documenti validi (privacy, termini, footer):
# LEGAL_COMPANY_NAME=
# LEGAL_VAT_ID=
# LEGAL_ADDRESS_LINE=
# LEGAL_CITY=
# LEGAL_POSTAL_CODE=
# LEGAL_EMAIL_PRIVACY=

