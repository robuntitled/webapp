# Copia questo file in .env.local e compila i valori reali.
# NON committare mai .env.local su GitHub.

# ── App ──────────────────────────────────────────────────────────────────────
AUTH_SECRET=
NEXT_PUBLIC_APP_NAME=NomadLink
# NEXT_PUBLIC_APP_URL=https://tuodominio.it

# ── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Connection string PostgreSQL (Supabase → Settings → Database → URI)
# Necessaria per migration DB: npm run db:security / npm run db:gdpr
SUPABASE_DB_URL=

# ── AI Composer (Ollama / Groq / OpenAI-compatible / Gemini) ─────────────────
# AI_COMPOSER_ENABLED=true
# AI_PROVIDER=openai
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2:3b
# AI_API_KEY=              # opzionale per Ollama locale; obbligatorio per Groq/OpenAI cloud
# AI_JSON_MODE=false       # true solo se il modello supporta response_format json_object
# AI_SINGLE_MESSAGE=true   # unisce system+user (consigliato per modelli piccoli)
# AI_MAX_OUTPUT_TOKENS=800
# mock = solo smart locale | auto = AI se disponibile | openai | gemini
# AI_COMPOSER_MODE=auto
# AI_TIMEOUT_MS=45000
# Kill-switch costi (consigliato in produzione): 10-50 USD/mese
# AI_MONTHLY_BUDGET_USD=20
# AI_CACHE_TTL_MS=86400000
#
# Alternativa Gemini (cloud) — API key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash-lite
# Qualità superiore con billing Google attivo:
# AI_MODEL=gemini-3.5-flash
#
# Nota free tier: ~10 richieste/min. Evita click ripetuti su "Suggerisci giornata";
# la cache riduce le chiamate.

# ── Mapbox (mappa del trip composer) ───────────────────────────────────────────
# Crea un token pubblico su https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# ── Altri servizi ────────────────────────────────────────────────────────────
PEXELS_API_KEY=

# ── Travelpayouts (affiliate) ────────────────────────────────────────────────
# MINIMO OBBLIGATORIO per ricerca voli/hotel e link affiliate:
# 1. Iscriviti ad Aviasales + Booking.com su https://app.travelpayouts.com/programs
# 2. Dashboard → Profile → API token → copia Partner ID (marker) e API token
#
# Partner ID (shmarker nei widget embed)
NEXT_PUBLIC_TRAVELPAYOUTS_MARKER=
#
# Project ID — Tools → Projects (es. 548437)
NEXT_PUBLIC_TRAVELPAYOUTS_TRS_ID=
# Server-side (link API legacy, opzionale se usi solo widget)
TRAVELPAYOUTS_TRS_ID=
#
# Promo ID dai widget Travelpayouts (tab Customize and copy)
NEXT_PUBLIC_TRAVELPAYOUTS_SEARCH_PROMO_ID=7879
NEXT_PUBLIC_TRAVELPAYOUTS_MAP_PROMO_ID=4054
NEXT_PUBLIC_TRAVELPAYOUTS_CAMPAIGN_ID=100
#
# API token (server-only) — link affiliate via API + stime prezzo in cache
TRAVELPAYOUTS_API_TOKEN=
#
# Origine voli default (Italia)
NEXT_PUBLIC_TRAVELPAYOUTS_DEFAULT_ORIGIN_IATA=ROM
#
# Widget White Label — form + risultati LIVE nel composer (consigliato se hai wl_id):
# 1. Travelpayouts → White Label → WL Web → Create → tipo Widget
# 2. Tab "Your widget code" → copia wl_id (es. 19658)
# Se imposti WL_ID, ha priorità sul widget tpemd (TRS+marker).
# NEXT_PUBLIC_TRAVELPAYOUTS_WL_ID=19658
#
# Tipo Page (sottodominio brandizzato, consigliato):
# 1. CNAME ricerca.tuodominio.it → host indicato da Travelpayouts
# 2. WL Web → Page → inserisci ricerca.tuodominio.it
# 3. Personalizza colori con i valori in lib/travelpayouts/config.ts
# NEXT_PUBLIC_TRAVELPAYOUTS_FLIGHTS_DOMAIN=ricerca.tuodominio.it
# NEXT_PUBLIC_TRAVELPAYOUTS_HOTEL_DOMAIN=ricerca.tuodominio.it
# NEXT_PUBLIC_TRAVELPAYOUTS_DEFAULT_ORIGIN_IATA=ROM
#
# Tipo Widget (alternativa senza sottodominio — copia wl_id dalla tab "Your widget code"):
# NEXT_PUBLIC_TRAVELPAYOUTS_WL_ID=1

# ── Profilo legale (GDPR) — compila prima del lancio in produzione ───────────
# Obbligatori per documenti validi (privacy, termini, footer):
# LEGAL_COMPANY_NAME=
# LEGAL_VAT_ID=
# LEGAL_ADDRESS_LINE=
# LEGAL_CITY=
# LEGAL_POSTAL_CODE=
# LEGAL_EMAIL_PRIVACY=

